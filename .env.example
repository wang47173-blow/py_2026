# Fill locally only
EKA_FIREWORKS_API_KEY=
EKA_FIREWORKS_MODEL=accounts/fireworks/models/glm-5

EKA_DATABASE_URL=postgresql+psycopg://app:app@postgres:5432/eka
EKA_LOG_LEVEL=INFO

EKA_QUERY_TIMEOUT_S=25
EKA_MAX_TOP_K=8
EKA_MAX_CONTEXT_CHARS=12000
EKA_ENABLE_RATE_LIMIT=true
EKA_RATE_LIMIT_REQUESTS_PER_MINUTE=60
